# ─── Felix environment ───────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# GitHub PAT (read PR + issues; write the verdict comment).
# Scopes: repo (read), and write only if FELIX_POST_COMMENT=true.
GITHUB_TOKEN=

# Tier 3 cross-family judge. MUST be a different model family than the code
# generator (Claude). Felix refuses to run with an Anthropic judge.
#
# Two vendors are supported — pick ONE with FELIX_JUDGE_FAMILY and set that
# family's key. Gemini is a genuinely different vendor from OpenAI (a stronger
# cross-family second opinion) and is cheaper (~$0.13 vs $0.25 per PR).
#   openai → set OPENAI_API_KEY   (default model gpt-4.1)
#   gemini → set GEMINI_API_KEY   (default model gemini-3.6-flash)
FELIX_JUDGE_FAMILY=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Override the judge model (optional). Leave BLANK to use the family default above.
FELIX_JUDGE_MODEL=
# Adversarial "refute-first" judging (opt-in). When on, the judge must argue the
# strongest reason each criterion is NOT met before deciding — cuts over-eager
# "met" verdicts. Off by default. Per-repo alt: "judge": {"adversarial": true} in
# felix.config.json.
FELIX_JUDGE_ADVERSARIAL=false

# Supabase verdict log (optional — Felix warns and continues if unset).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Behavior flags.
# FELIX_DRY_RUN=true  -> compute + print the verdict, do NOT post a comment.
# FELIX_POST_COMMENT  -> when not dry-run, post/update the PR comment.
FELIX_DRY_RUN=true
FELIX_POST_COMMENT=false

# ── Local pre-flight (`felix preflight`) ──────────────────────────────────────
# Pre-flight needs NEITHER of the two blocks above: no GITHUB_TOKEN, no SUPABASE_*.
# It publishes nothing, and probe-preflight-containment.js asserts it cannot.
#
# A SEPARATE judge key for pre-flight, so a runaway local loop cannot spend the budget CI
# depends on. Give it a hard monthly limit at the vendor — that is the only cap an agent
# invoking the CLI cannot code around. Falls back to OPENAI_API_KEY with a warning.
OPENAI_API_KEY_PREFLIGHT=
# Advisory ceiling on GRADED pre-flight runs per day (default 20). A tripwire, not a wall:
# the counter is a file in the system temp dir and can be deleted.
# FELIX_PREFLIGHT_JUDGE_CAP=20
